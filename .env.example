# =============================================================================
# Chat3D — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# Required: at least one LLM API key (OpenAI, Anthropic, xAI, or Ollama).
# Everything else has sensible defaults for local Docker development.
# =============================================================================

# --- Database (PostgreSQL) ---------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_USER=chat3d
DB_PASSWORD=chat3d_dev
DB_NAME=chat3d

# --- Redis (SSE event bus) ---------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
EVENT_BUS_MODE=redis
REDIS_EVENT_CHANNEL=chat3d.notifications

# --- Auth & Security ---------------------------------------------------------
JWT_SECRET=change-this

# --- Seed Admin Account (created on first db:bootstrap) ----------------------
SEED_ADMIN_EMAIL=admin@chat3d.local
SEED_ADMIN_PASSWORD=change-admin-password
SEED_ADMIN_DISPLAY_NAME=Initial Admin

# --- LLM Providers -----------------------------------------------------------
# Set at least one API key. Leave unused providers blank.
OPENAI_API_KEY=
# Optional: redirect OpenAI calls to a self-hosted OpenAI-compatible service (vLLM, LiteLLM, etc.)
# OPENAI_BASE_URL=http://my-local-service:8000/v1
ANTHROPIC_API_KEY=
XAI_API_KEY=

# Ollama (local LLM — no API key needed, just a running instance)
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_TOKEN=

# --- LLM Routing -------------------------------------------------------------
QUERY_RENDER_MODE=live
QUERY_LLM_MODE=live
QUERY_CONVERSATION_PROVIDER=openai
QUERY_CODEGEN_PROVIDER=openai
QUERY_CONVERSATION_MODEL=gpt-4o-mini
QUERY_CODEGEN_MODEL=gpt-5.2-codex

# --- Build123d Rendering Service ---------------------------------------------
BUILD123D_PORT=30222
BUILD123D_URL=http://build123d:80

# --- STL Rendering Service (for workbench visual evaluation) ----------------
STL_RENDERING_SERVICE_URL=http://stl-rendering-service:3002

# --- Workbench Code Generation (optional — defaults to main LLM config above)
# Set these to use a different provider/model for workbench codegen
# WORKBENCH_CODEGEN_PROVIDER=ollama
# WORKBENCH_CODEGEN_MODEL=qwen2.5-coder:32b

# --- Workbench VLM Evaluation ------------------------------------------------
# Provider for visual evaluation of generated 3D models (anthropic | openai | ollama)
EVAL_VLM_PROVIDER=openai
EVAL_VLM_MODEL=gpt-4o-mini

# --- Workbench Embeddings ----------------------------------------------------
# Provider for prompt embeddings used in few-shot selection (openai | ollama)
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-large

# --- Email / SMTP (optional — leave blank to disable outbound email) ---------
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=no-reply@example.com
EMAIL_TRANSPORT=smtp
EMAIL_RETRY_COUNT=2
EMAIL_RETRY_DELAY_MS=250
EMAIL_CONNECTION_TIMEOUT_MS=10000
EMAIL_SOCKET_TIMEOUT_MS=20000

# --- Account Cleanup Worker --------------------------------------------------
ACCOUNT_DELETION_SWEEP_INTERVAL_SECONDS=3600
ACCOUNT_DELETION_SWEEP_LIMIT=100

# --- App ---------------------------------------------------------------------
APP_BASE_URL=http://localhost
