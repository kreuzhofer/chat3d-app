# =============================================================================
# Chat3D — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# Required: at least one LLM API key (OpenAI, Anthropic, xAI, or Ollama).
# Everything else has sensible defaults for local Docker development.
# =============================================================================

# --- Database (PostgreSQL) ---------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_USER=chat3d
DB_PASSWORD=chat3d_dev
DB_NAME=chat3d
# DB_SSL=false

# --- Redis (SSE event bus) ---------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
EVENT_BUS_MODE=redis
REDIS_EVENT_CHANNEL=chat3d.notifications

# --- Auth & Security ---------------------------------------------------------
JWT_SECRET=change-this

# --- Seed Admin Account (created on first db:bootstrap) ----------------------
SEED_ADMIN_EMAIL=admin@chat3d.local
SEED_ADMIN_PASSWORD=change-admin-password
SEED_ADMIN_DISPLAY_NAME=Initial Admin

# --- LLM Provider Defaults ---------------------------------------------------
# API keys and endpoint URLs for LLM providers are now managed via the Admin UI
# (Admin → Providers tab). The env vars below are ONLY used as fallbacks when
# the Vercel AI SDK needs a key and the provider row in the database has no
# api_key set. For most setups, configure keys in the Admin UI instead.
#
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# XAI_API_KEY=

# Ollama (local LLM — no API key needed, just a running instance)
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_TOKEN=

# --- LLM Routing -------------------------------------------------------------
QUERY_RENDER_MODE=live
QUERY_LLM_MODE=live
QUERY_CONVERSATION_PROVIDER=openai
QUERY_CODEGEN_PROVIDER=openai
QUERY_CONVERSATION_MODEL=gpt-4o-mini
QUERY_CODEGEN_MODEL=gpt-5.2-codex

# --- Build123d Rendering Service ---------------------------------------------
BUILD123D_URL=http://build123d:80

# --- Screenshot Service (pyrender + EGL, independent from Build123d) ---------
SCREENSHOT_SERVICE_URL=http://screenshot-service:80

# --- Concurrency Control -----------------------------------------------------
# Semaphore limits for shared resources. Defaults match Docker replica counts.
# BUILD123D_MAX_CONCURRENT=2
# BUILD123D_QUEUE_TIMEOUT_MS=180000
# SCREENSHOT_MAX_CONCURRENT=2
# SCREENSHOT_QUEUE_TIMEOUT_MS=60000
# LLM_MAX_CONCURRENT=5
# LLM_QUEUE_TIMEOUT_MS=120000
# LLM_RETRY_MAX_ATTEMPTS=3
# LLM_RETRY_BASE_DELAY_MS=2000
# LLM_RETRY_MAX_DELAY_MS=60000

# --- Workbench Code Generation (optional — defaults to main LLM config above)
# Set these to use a different provider/model for workbench codegen
# WORKBENCH_CODEGEN_PROVIDER=ollama
# WORKBENCH_CODEGEN_MODEL=qwen2.5-coder:32b

# --- Workbench VLM Evaluation ------------------------------------------------
# Provider for visual evaluation of generated 3D models (anthropic | openai | ollama)
EVAL_VLM_PROVIDER=openai
EVAL_VLM_MODEL=gpt-4o-mini

# --- Workbench Embeddings ----------------------------------------------------
# Provider for prompt embeddings used in few-shot selection (openai | ollama)
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-large

# --- Email / SMTP (optional — leave blank to disable outbound email) ---------
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=no-reply@example.com
EMAIL_TRANSPORT=smtp
EMAIL_RETRY_COUNT=2
EMAIL_RETRY_DELAY_MS=250
EMAIL_CONNECTION_TIMEOUT_MS=10000
EMAIL_SOCKET_TIMEOUT_MS=20000

# --- Security / CORS (sensible defaults — override only if needed) -----------
# CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:80,http://localhost:5173
# RATE_LIMIT_WINDOW_MS=60000
# RATE_LIMIT_GENERAL_MAX=500
# RATE_LIMIT_LOGIN_MAX=50
# RATE_LIMIT_QUERY_MAX=50

# --- Waitlist & Invitations --------------------------------------------------
# WAITLIST_CONFIRMATION_TOKEN_TTL_HOURS=24
# WAITLIST_REGISTRATION_TOKEN_TTL_HOURS=168
# INVITATION_REGISTRATION_TOKEN_TTL_HOURS=168

# --- Account Cleanup Worker --------------------------------------------------
ACCOUNT_DELETION_SWEEP_INTERVAL_SECONDS=3600
ACCOUNT_DELETION_SWEEP_LIMIT=100

# --- App ---------------------------------------------------------------------
APP_BASE_URL=http://localhost
# STORAGE_ROOT_DIR=/data/storage

# --- Logging -----------------------------------------------------------------
# LOG_LEVEL: fatal | error | warn | info (default) | debug | trace | silent
# LOG_FORMAT: json (default in Docker) | pretty (human-readable for local dev)
# LOG_LEVEL=info
# LOG_FORMAT=json
