<h2 style="margin: 0 0 16px; color: #333333; font-size: 20px; font-weight: 600;">
  {{t "forgotPassword.heading" lng=lang}}
</h2>
<p style="margin: 0 0 24px; color: #555555; font-size: 15px; line-height: 1.5;">
  {{t "forgotPassword.body" lng=lang}}
</p>
<table role="presentation" cellpadding="0" cellspacing="0" style="margin: 0 auto;">
  <tr>
    <td style="border-radius: 6px; background-color: #2185d0;">
      <a href="{{resetUrl}}" style="display: inline-block; padding: 12px 32px; color: #ffffff; text-decoration: none; font-size: 15px; font-weight: 600;">
        {{t "forgotPassword.buttonText" lng=lang}}
      </a>
    </td>
  </tr>
</table>
<p style="margin: 16px 0 0; color: #999999; font-size: 13px;">
  {{t "forgotPassword.expiry" lng=lang}}
</p>
