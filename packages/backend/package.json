{
  "name": "@chat3d/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "db:migrate": "npx prisma migrate deploy",
    "db:bootstrap": "npm run db:migrate",
    "worker:account-deletion": "tsx src/workers/account-deletion.worker.ts",
    "test": "npm run db:migrate && vitest run",
    "test:integration": "npm run db:migrate && vitest run src/__tests__/auth.integration.test.ts src/__tests__/waitlist.integration.test.ts src/__tests__/invitations.integration.test.ts src/__tests__/admin.integration.test.ts src/__tests__/account-lifecycle.integration.test.ts src/__tests__/chat-files.integration.test.ts src/__tests__/query.integration.test.ts src/__tests__/hardening.integration.test.ts"
  },
  "dependencies": {
    "@ai-sdk/amazon-bedrock": "^4.0.65",
    "@ai-sdk/anthropic": "^3.0.0",
    "@ai-sdk/deepseek": "^2.0.20",
    "@ai-sdk/openai": "^3.0.0",
    "@ai-sdk/openai-compatible": "^2.0.0",
    "@ai-sdk/xai": "^3.0.0",
    "@prisma/adapter-pg": "^7.4.2",
    "@prisma/client": "^7.4.2",
    "ai": "^6.0.0",
    "archiver": "^7.0.1",
    "bcryptjs": "^3.0.2",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "handlebars": "^4.7.8",
    "i18next": "^25.8.13",
    "i18next-fs-backend": "^2.6.1",
    "jose": "^6.1.0",
    "multer": "^2.0.2",
    "nodemailer": "^8.0.1",
    "pg": "^8.16.3",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "redis": "^5.9.0",
    "unzipper": "^0.12.3",
    "vercel-minimax-ai-provider": "^0.0.2",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@types/archiver": "^7.0.0",
    "@types/express": "^5.0.3",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.3.0",
    "@types/nodemailer": "^7.0.2",
    "@types/supertest": "^6.0.3",
    "@types/unzipper": "^0.10.11",
    "@types/web-push": "^3.6.4",
    "fast-check": "^4.5.3",
    "prisma": "^7.4.2",
    "supertest": "^7.1.4",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.0.0"
  }
}
